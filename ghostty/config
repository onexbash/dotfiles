# -- Theme -- #
theme = catppuccin-mocha.conf
custom-shader = shaders/space.glsl

# -- Font -- #
font-family = "ShureTech Nerd Font"
font-size = 18

# -- Cursor -- #
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# -- Scroll -- #
mouse-scroll-multiplier = 2
scrollbar = never

# -- Window -- #
window-decoration = auto
window-padding-color = extend
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-inherit-working-directory = true

# -- Background -- #
background-image = wallpaper/cpc_sailormoon-square.jpg
background-image-opacity = 0.2
background-image-position = center
background-image-fit = contain

# -- Options -- #
confirm-close-surface = false

# -- Shell -- #
initial-command = $SHELL -lic "exec tuios"

# -- MacOS -- #
macos-option-as-alt = left
macos-titlebar-style = hidden

# -- Keybinds -- #
# Default MacOS Keybinds
keybind = alt+digit_5=text:[
keybind = alt+digit_6=text:]
keybind = alt+digit_7=text:|
keybind = alt+shift+digit_7=text:\\
keybind = alt+digit_8=text:{
keybind = alt+digit_9=text:}
keybind = alt+key_n=text:~
keybind = alt+shift+key_l=text:@
