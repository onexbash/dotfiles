# -- GENERAL -- #
[core]
  editor = nvim
  excludesFile = ~/.config/git/gitignore
  pager = delta
[user]
  name = onexbash
  email = fabian@schlegel.one
[interactive]
  diffFilter = delta --color-only

# -- DELTA + CATPPUCCIN -- #
[include]
  path = themes/catppuccin.gitconfig
[delta]
  features = catppuccin-mocha
  line-numbers = true
  hunk-header-style = line-number syntax

# -- DIFF / MERGE -- #
[diff]
  algorithm = histogram
  colorMoved = default
[merge]
  conflictStyle = zdiff3

# -- WORKFLOW -- #
[init]
  defaultBranch = main
[fetch]
  prune = true
[pull]
  rebase = true
[rebase]
  autoStash = true
[push]
  autoSetupRemote = true

# -- CREDENTIALS -- #
[credential]
  helper =
  helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
  useHttpPath = true
