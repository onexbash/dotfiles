{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(~/.config/scripts/crewx/worktree *)",
      "Bash(~/.config/scripts/crewx/crewx gate*)",
      "Bash(git rebase:*)",
      "Bash(tuios set-agent-meta *)",
      "Bash(tuios send-agent-message *)",
      "Bash(tuios ask-human *)",
      "Bash(tuios read-agent-messages *)"
    ],
    "deny": [
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  }
}
