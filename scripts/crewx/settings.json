{
  "teammateMode": "tmux",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(~/.config/scripts/crewx/worktree *)",
      "Bash(git rebase:*)"
    ],
    "deny": ["Bash(git switch:*)", "Bash(git checkout:*)", "Bash(git reset --hard:*)", "Bash(rm -rf:*)", "Bash(rm -fr:*)"]
  },
  "hooks": {
    "TaskCreated": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/scripts/crewx/log-event.sh", "timeout": 5 }] }
    ],
    "TaskCompleted": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/scripts/crewx/log-event.sh", "timeout": 5 }] }
    ],
    "TeammateIdle": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/scripts/crewx/log-event.sh", "timeout": 5 }] }
    ]
  }
}
