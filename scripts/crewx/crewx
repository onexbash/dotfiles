#!/usr/bin/env bash
# crewx: Claude Code crew in tuios. One lead per goal, parallel implement/test/docs, one state file per session.
# Run `crewx help` for the commands. USAGE.md has the whole picture.
set -euo pipefail

CREWX="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
PLUGIN="$CREWX/plugin"
SETTINGS="$CREWX/settings.json"
INDEX="${XDG_STATE_HOME:-$HOME/.local/state}/crewx/index.tsv"

# Log & input functions (log_*, input_*) from the shell utilities; plain fallbacks keep `status` and `doctor` usable without them.
UTIL_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/shell/util.sh"
# shellcheck source=/dev/null
if ! source "$UTIL_FILE" 2>/dev/null; then
  log_ok() { echo "ok    $*"; }
  log_info() { echo "info  $*"; }
  log_warn() { echo "warn  $*" >&2; }
  log_err() { echo "error $*" >&2; }
  input_ask() { printf '%s ' "$2" >&2 && read -r "$1"; }
fi

usage() {
  cat <<'EOF'
Usage: crewx <command> [args]
  start [dir] [-p PROMPT]   open (or reuse) the project's tuios session with the lead (default dir: .)
  new <name> [PROMPT...]    start a parallel goal: worktree feat-<name> off the current branch, its own
                            tuios session and lead; PROMPT is typed as the lead's first request
  status [-w|--watch]       every crewx session on this machine: goal, status, waiting points, age
  gate [dir]                run the project's .crewx/verify by hand
  doctor                    check tools, integration and the agent files
  help                      this text
EOF
}

lead_cmd() { # lead_cmd [prompt]: the command line that starts the lead in a shell pane
  local cmd
  cmd="claude --agent crewx:jarvis --plugin-dir $(printf %q "$PLUGIN") --settings $(printf %q "$SETTINGS")"
  [ -z "${1:-}" ] || cmd="$cmd $(printf %q "$1")"
  printf '%s\n' "$cmd"
}

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"; } # GNU stat first: `stat -f` means something else there

need() { command -v "$1" >/dev/null || {
  log_err "crewx: $1 is not on PATH"
  exit 1
}; }

# Claude Code workspace trust. Claude Code keeps the answer to its "Do you trust this folder?" dialog in
# ~/.claude.json (projects[<git root>].hasTrustDialogAccepted), keyed on the git root, or the main checkout
# for a worktree. When that key lies inside one of the colon-separated dirs in $CLAUDE_TRUSTED_DIRS, it is
# pre-accepted so the lead doesn't stop at the dialog. Only that exact key is written, never a parent folder.
claude_trust() { # $1: resolved project dir; returns 1 on a failed write, 0 otherwise
  [ -n "${CLAUDE_TRUSTED_DIRS:-}" ] || return 0
  command -v jq >/dev/null || return 0
  local project="$1" key common entry t trusted=0 cfg tmp
  local -a entries

  common="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  case "$common" in
  */.git) key="${common%/.git}" ;;
  *) key="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || echo "$project")" ;;
  esac
  key="$(cd "$key" && pwd -P)" || return 1
  [ -n "$key" ] || return 1

  IFS=: read -r -a entries <<<"$CLAUDE_TRUSTED_DIRS"
  [ "${#entries[@]}" -gt 0 ] || return 0
  for entry in "${entries[@]}"; do
    [ -n "$entry" ] || continue
    entry="${entry/#\~/$HOME}"
    [ -d "$entry" ] || continue
    t="$(cd "$entry" && pwd -P)" || continue
    case "$key" in "$t" | "$t"/*)
      trusted=1
      break
      ;;
    esac
  done
  [ "$trusted" = 1 ] || return 0

  cfg="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
  [ -f "$cfg" ] || return 0                                          # Claude Code never ran: let it create its config, the dialog shows once
  if [ -L "$cfg" ]; then cfg="$(readlink -f "$cfg")" || return 1; fi # write through a symlink, don't replace it
  jq -e --arg p "$key" '.projects[$p].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1 && return 0

  [ -e "$cfg.crewx-backup" ] || cp -p "$cfg" "$cfg.crewx-backup" || return 1
  tmp="$(mktemp "$cfg.XXXXXX")" || return 1
  if jq --arg p "$key" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$cfg" >"$tmp"; then
    mv "$tmp" "$cfg" || {
      rm -f "$tmp"
      return 1
    }
    log_ok "crewx: Claude Code now trusts $key (inside CLAUDE_TRUSTED_DIRS)"
  else
    rm -f "$tmp"
    return 1
  fi
}

prepare_project() { # prepare_project <dir>: .crewx/ (kept out of git) and the branch guard
  local dir="$1" guard rc choice name exclude
  guard="$(cd "$dir" && "$CREWX/worktree" check 2>/dev/null)" && rc=0 || rc=$?
  if [ "$rc" = 2 ]; then
    log_err "crewx: $dir is not a git repository; crewx needs git (worktrees, the gate). Run 'git init' and commit once first."
    exit 1
  elif [ "$rc" = 3 ] && [ -t 0 ]; then
    log_warn "crewx: $dir is on '${guard#not-feature-branch }', not a feat-* branch."
    input_ask choice "crewx: [p]roceed on it, [n]ew feat branch, [q]uit?"
    case "$choice" in
    p*) (cd "$dir" && "$CREWX/worktree" approve-branch) ;;
    n*)
      input_ask name "crewx: name for the new branch (feat-<name>):"
      (cd "$dir" && "$CREWX/worktree" new-feature "$name")
      ;;
    *) exit 0 ;;
    esac
  fi # not a terminal: the lead asks through the tuios Inbox instead

  mkdir -p "$dir/.crewx/sessions" "$dir/.crewx/run"
  exclude="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  git -C "$dir" check-ignore -q .crewx/sessions || {
    mkdir -p "$(dirname "$exclude")"
    echo "/.crewx/" >>"$exclude"
  }
  claude_trust "$dir" || log_warn "crewx: could not pre-trust $dir for Claude Code; accept the trust dialog in the Lead pane"
}

cmd_start() {
  local dir="" prompt="" coding=1 attach=1
  while [ $# -gt 0 ]; do
    case "$1" in
    -p | --prompt) prompt="${2:?--prompt needs text}" && shift ;;
    --no-coding) coding=0 ;;
    --detach) attach=0 ;;
    -*) usage >&2 && exit 1 ;;
    *) dir="$1" ;;
    esac
    shift
  done
  dir="${dir:-$PWD}"
  [ -d "$dir" ] || {
    log_err "crewx: project directory not found: $dir"
    exit 1
  }
  dir="$(cd "$dir" && pwd -P)"
  need tuios
  need jq
  need claude

  integration="$(tuios integration status claude-code 2>/dev/null | head -n1 || true)"
  if [[ "$integration" != *"installed, current"* ]]; then
    log_warn "crewx: the tuios Claude Code integration is not installed and current: ${integration:-unknown}"
    log_warn "crewx: without it the rail, Inbox approvals and mail notices don't work. Fix: tuios integration install claude-code"
  fi

  prepare_project "$dir"

  local session fresh=0
  session="crewx-$(basename "$dir")"
  if ! tuios ls --json | jq -e --arg s "$session" 'any(.[]; .name == $s)' >/dev/null; then
    tuios new "$session" --detach --cwd "$dir" >/dev/null
    fresh=1
  fi

  win_id() { # id of the window named $1, empty if none
    tuios list-windows -s "$session" --json |
      jq -r --arg n "$1" '.windows[] | select(.display_name == $n) | .window_id' | head -n1
  }

  # A session from crewx 1 calls its workspaces Jarvis and Logs: rename them in place.
  tuios set-workspace-name -s "$session" 2 Lead >/dev/null
  tuios set-workspace-name -s "$session" 3 Board >/dev/null
  tuios set-workspace-name -s "$session" 4 Worktrees >/dev/null
  [ -z "$(win_id Jarvis)" ] || tuios set-window -s "$session" -w Jarvis --name Lead >/dev/null

  # Workspace 2: the Lead pane, a shell, so it survives when claude exits.
  local lead first
  lead="$(win_id Lead)"
  if [ -z "$lead" ]; then
    first="$(tuios list-windows -s "$session" --json | jq -r '.windows[0].window_id')"
    if [ "$fresh" = 1 ] && [ "$coding" = 0 ]; then # no Coding workspace: the session's first window becomes the Lead
      lead="$first"
      tuios set-window -s "$session" -w "$lead" --name Lead >/dev/null
      tuios move-window 2 -s "$session" -w "$lead" >/dev/null
    else
      lead="$(tuios new-window Lead -s "$session" --workspace 2 --cwd "$dir" --no-focus --print-id)"
    fi
  fi
  local tty procs
  tty="$(tuios list-windows -s "$session" --json | jq -r --arg id "$lead" '.windows[] | select(.window_id == $id) | .tty')"
  procs="$(ps -t "${tty#/dev/}" -o command= 2>/dev/null || true)" # not piped into grep -q: pipefail + SIGPIPE
  if [[ "$procs" == *"--agent crewx:jarvis"* ]]; then
    log_info "crewx: the lead is already running in $session"
    [ -z "$prompt" ] || tuios queue -s "$session" -w "$lead" "$prompt" >/dev/null
  elif [[ "$procs" == *"claude --agent jarvis"* ]]; then
    log_warn "crewx: a crewx 1 Jarvis runs in $session. Exit him (/exit) and run crewx start again."
  else
    tuios send-text -s "$session" -w "$lead" "cd $(printf %q "$dir") && $(lead_cmd "$prompt")
" >/dev/null
  fi

  # Workspace 1: Coding. The Editor pane runs nvim from a shell; layout-coding.sh adds lazygit and a shell.
  if [ "$coding" = 1 ] && [ -z "$(win_id Editor)" ]; then
    local editor
    if [ "$fresh" = 1 ]; then
      editor="$(tuios list-windows -s "$session" --json | jq -r '.windows[0].window_id')"
      tuios set-window -s "$session" -w "$editor" --name Editor >/dev/null
    else
      editor="$(tuios new-window Editor -s "$session" --workspace 1 --cwd "$dir" --no-focus --print-id)"
    fi
    tuios send-text -s "$session" -w "$editor" "cd $(printf %q "$dir") && nvim
" >/dev/null
    nohup "$CREWX/layout-coding.sh" "$session" "$dir" "$lead" >/dev/null 2>&1 &
  fi

  # Workspace 3: Board. Left this project's current state file, right every crewx session on the machine.
  # Old crewx 1 log panes are closed; they read files that no longer exist.
  local old
  for old in Activity Plan; do [ -z "$(win_id "$old")" ] || tuios close-window -s "$session" "$old" >/dev/null 2>&1 || true; done
  [ -n "$(win_id State)" ] || tuios new-window State -s "$session" --workspace 3 --cwd "$dir" --no-focus -- "$CREWX/panes/state.sh" "$dir" >/dev/null
  [ -n "$(win_id Sessions)" ] || tuios new-window Sessions -s "$session" --workspace 3 --cwd "$dir" --no-focus -- "$CREWX/crewx" status --watch >/dev/null

  # Workspace 4: live `wt list` of the worktrees (team path packages, parallel goals).
  [ -n "$(win_id Worktrees)" ] || tuios new-window Worktrees -s "$session" --workspace 4 --cwd "$dir" --no-focus -- "$CREWX/panes/worktrees.sh" "$dir" >/dev/null

  tuios select-workspace -s "$session" 2 >/dev/null
  tuios focus-window -s "$session" "$lead" >/dev/null || true

  if [ "$attach" = 0 ]; then
    log_ok "crewx: $session is running (detached). Its questions and results reach the tuios Inbox."
  elif [ -n "${TUIOS_SESSION:-}" ]; then
    exec tuios switch-session "$session"
  else
    exec tuios attach "$session"
  fi
}

cmd_new() { # crewx new <name> [prompt...]
  local name="${1:-}" prompt base main path
  [ -n "$name" ] || {
    usage >&2
    exit 1
  }
  shift
  prompt="$*"
  need wt
  name="${name#feat-}"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || {
    log_err "crewx: use letters, digits, dot, dash or underscore in the name"
    exit 1
  }
  main="$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')"
  [ -n "$main" ] || {
    log_err "crewx: not inside a git repository"
    exit 1
  }
  base="$(git -C "$main" symbolic-ref --quiet --short HEAD)" || {
    log_err "crewx: the main worktree has a detached HEAD"
    exit 1
  }
  git -C "$main" show-ref --quiet "refs/heads/feat-$name" && {
    log_err "crewx: branch feat-$name already exists"
    exit 1
  }
  wt -C "$main" switch --create "feat-$name" --base "$base" --no-cd >&2 # runs the project's wt hooks (deps, env files)
  path="$(git -C "$main" worktree list --porcelain | awk -v b="branch refs/heads/feat-$name" '/^worktree /{p=substr($0,10)} $0==b{print p}')"
  [ -n "$path" ] || {
    log_err "crewx: wt did not create a worktree for feat-$name"
    exit 1
  }
  log_ok "crewx: feat-$name in $path (from $base). Merge it back yourself when it's done; crewx never merges goals."
  if [ -n "$prompt" ]; then
    cmd_start "$path" --no-coding --detach --prompt "$prompt"
  else
    cmd_start "$path" --no-coding
  fi
}

status_once() {
  local now attention rows=0
  now="$(date +%s)"
  attention="$(tuios list-attention --json 2>/dev/null | jq -r '.total // empty' 2>/dev/null || true)"
  printf 'crewx sessions · %s · Inbox: %s waiting (Ctrl+B i)\n\n' "$(date '+%H:%M')" "${attention:-?}"
  printf '%-11s %-5s %-6s %-26s %s\n' STATUS WAIT AGE PROJECT GOAL
  [ -f "$INDEX" ] || {
    echo "(no sessions yet)"
    return 0
  }
  # newest entry per file, files that still exist, newest first; done sessions only for 2 days
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    local mt age st goal proj wait branch
    mt="$(mtime "$f")"
    st="$(sed -n 's/^status: *//p' "$f" | head -n1)"
    [ "$st" = done ] && [ $((now - mt)) -gt 172800 ] && continue
    goal="$(sed -n 's/^goal: *//p' "$f" | head -n1)"
    proj="$(sed -n 's/^project: *//p' "$f" | head -n1)"
    branch="$(sed -n 's/^branch: *//p' "$f" | head -n1)"
    wait="$(awk '/^## Waiting on human/{f=1; next} /^## /{f=0} f && /^[-*] |^[0-9]+\. /' "$f" | wc -l | tr -d ' ')"
    age=$((now - mt))
    if [ "$age" -lt 3600 ]; then age="$((age / 60))m"; elif [ "$age" -lt 172800 ]; then age="$((age / 3600))h"; else age="$((age / 86400))d"; fi
    printf '%-11s %-5s %-6s %-26.26s %s\n' "${st:-?}" "$wait" "$age" "$(basename "$proj"):$branch" "${goal:-?}"
    rows=$((rows + 1))
  done < <(cut -f1 "$INDEX" | awk '!seen[$0]++' | while IFS= read -r f; do [ -f "$f" ] && printf '%s\t%s\n' "$(mtime "$f")" "$f"; done | sort -rn | cut -f2-)
  [ "$rows" -gt 0 ] || echo "(no active sessions)"
}

cmd_status() {
  case "${1:-}" in
  -w | --watch)
    printf '\e]2;crewx sessions\a'
    while :; do
      out="$(status_once 2>&1)"
      clear
      printf '%s\n' "$out"
      sleep 5
    done
    ;;
  *) status_once ;;
  esac
}

cmd_gate() {
  local dir root cmd
  dir="${1:-$PWD}"
  root="$(git -C "$dir" rev-parse --show-toplevel)"
  cmd="$(grep -v '^[[:space:]]*#' "$root/.crewx/verify" 2>/dev/null | sed '/^[[:space:]]*$/d' | head -n1 || true)"
  [ -n "$cmd" ] || {
    log_err "crewx: $root/.crewx/verify is missing or empty"
    exit 1
  }
  log_info "crewx gate: $cmd"
  (cd "$root" && bash -c "$cmd")
}

cmd_doctor() {
  local bad=0 t sums n old
  for t in tuios claude jq git wt glow; do
    if command -v "$t" >/dev/null; then log_ok "$t: $(command -v "$t")"; else
      log_warn "$t: missing"
      bad=1
    fi
  done
  if command -v tuios >/dev/null; then
    t="$(tuios integration status claude-code 2>/dev/null | head -n1 || true)"
    [[ "$t" == *"installed, current"* ]] && log_ok "tuios integration: $t" || {
      log_warn "tuios integration: ${t:-unknown}. Fix: tuios integration install claude-code"
      bad=1
    }
    t="$(tuios get-config agents.enabled 2>/dev/null || true)"
    [[ "$t" == *false* ]] && {
      log_warn "tuios agent features are off (agents.enabled = false)"
      bad=1
    }
  fi
  # the shared rules must be identical in every agent
  sums="$(for f in "$PLUGIN"/agents/*.md; do sed -n '/^<!-- shared rules:/,$p' "$f" | shasum | cut -c1-12; done | sort -u)"
  n="$(printf '%s\n' "$sums" | wc -l | tr -d ' ')"
  [ "$n" = 1 ] && log_ok "agents: shared rules identical in $(ls "$PLUGIN"/agents/*.md | wc -l | tr -d ' ') files" || {
    log_warn "agents: the shared rules differ between agent files"
    bad=1
  }
  jq -e . "$PLUGIN/hooks/hooks.json" "$PLUGIN/.claude-plugin/plugin.json" "$SETTINGS" >/dev/null && log_ok "json: hooks, plugin and settings parse" || bad=1
  # crewx 1 installed its agents globally; there they cost tokens in every session and shadow the plugin's bare names
  for old in jarvis asta yuno yami hinata; do
    [ -e "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agents/$old.md" ] && {
      log_warn "old crewx 1 agent in ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agents/$old.md: delete it (crewx 2 loads its agents from the plugin)"
      bad=1
    }
  done
  return "$bad"
}

case "${1:-help}" in
start) shift && cmd_start "$@" ;;
new) shift && cmd_new "$@" ;;
status) shift && cmd_status "$@" ;;
gate) shift && cmd_gate "$@" ;;
doctor) cmd_doctor ;;
-h | --help | help) usage ;;
*) usage >&2 && exit 1 ;;
esac
