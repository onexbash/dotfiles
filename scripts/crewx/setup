#!/usr/bin/env bash
# crewx setup: prepare a project and open (or reuse) its tuios session.
# Usage: ~/.config/scripts/crewx/setup [project-dir]
set -euo pipefail

CREWX="$HOME/.config/scripts/crewx"
SETTINGS="$CREWX/settings.json"

dir="${1:-$PWD}"
[ -d "$dir" ] || { echo "crewx: project directory not found: $dir" >&2; exit 1; }
dir="$(cd "$dir" && pwd -P)"
session="crewx-$(basename "$dir")"
command -v tuios >/dev/null || { echo "crewx: tuios is not on PATH" >&2; exit 1; }

# Agent states, mail notices and Inbox questions all come from the tuios Claude Code hooks.
integration="$(tuios integration status claude-code 2>/dev/null | head -n1 || true)"
if [[ "$integration" != *"installed, current"* ]]; then
  echo "crewx: the tuios Claude Code integration is not installed and current: ${integration:-unknown}" >&2
  echo "crewx: without it the rail, the Inbox and mail notices don't work. Fix: tuios integration install claude-code" >&2
  sleep 3
fi

# Branch guard, settled here in the terminal (no tokens, no waiting agents). The helper still guards every later step.
guard="$(cd "$dir" && "$CREWX/worktree" check 2>/dev/null)" && rc=0 || rc=$?
if [ "$rc" = 2 ]; then
  echo "crewx: $dir is not a git repository; workers need git worktrees. Run 'git init' and commit once first." >&2
  exit 1
elif [ "$rc" = 3 ] && [ -t 0 ]; then
  echo "crewx: the main worktree is on '${guard#not-feature-branch }', not a feat-* branch."
  read -r -p "crewx: [p]roceed on it, [n]ew feat branch, [q]uit? " choice
  case "$choice" in
    p*) (cd "$dir" && "$CREWX/worktree" approve-branch) ;;
    n*) read -r -p "crewx: name (feat-<name>): feat-" name
        (cd "$dir" && "$CREWX/worktree" new-feature "$name") ;;
    *)  exit 0 ;;
  esac
fi # not a terminal: Jarvis asks through the tuios Inbox instead

# Team-internal files live in .crewx/ (kept out of git locally); create only what is missing, never overwrite.
# docs/DECISIONS.md, the one committed file, is created by Jarvis when the first project decision comes up.
mkdir -p "$dir/.crewx"
[ -e "$dir/.crewx/STATE.md" ] || cp "$CREWX/templates/STATE.md" "$dir/.crewx/STATE.md"
[ -e "$dir/.crewx/activity.log" ] || : > "$dir/.crewx/activity.log"
exclude="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
git -C "$dir" check-ignore -q .crewx/STATE.md || { mkdir -p "$(dirname "$exclude")"; echo "/.crewx/" >> "$exclude"; }

# Session: reuse it if it exists.
fresh=0
if ! tuios ls --json | jq -e --arg s "$session" 'any(.[]; .name == $s)' >/dev/null; then
  tuios new "$session" --detach --cwd "$dir" >/dev/null
  fresh=1
fi

win_id() { # id of the window named $1, empty if none
  tuios list-windows -s "$session" --json \
    | jq -r --arg n "$1" '.windows[] | select(.display_name == $n) | .window_id' | head -n1
}

# A session from an older setup has Jarvis, Logs, Workers on 1-3: shift them to 2-4 (panes, names, layouts move along).
ws1="$(tuios list-workspaces -s "$session" --json | jq -r '.workspaces[] | select(.workspace == 1) | .name')"
[ "$ws1" = Jarvis ] && tuios call set-workspace-order "{\"session\":\"$session\",\"order\":[4,1,2,3]}" >/dev/null

tuios set-workspace-name -s "$session" 1 Coding >/dev/null
tuios set-workspace-name -s "$session" 2 Jarvis >/dev/null
tuios set-workspace-name -s "$session" 3 Logs >/dev/null
tuios set-workspace-name -s "$session" 4 Workers >/dev/null

# Workspace 4: live `wt list` of the worker worktrees (workers are subagents of Jarvis, not panes).
[ -n "$(win_id Worktrees)" ] || tuios new-window Worktrees -s "$session" --workspace 4 --cwd "$dir" --no-focus -- "$CREWX/logs-worktrees.sh" "$dir" >/dev/null

# Workspace 1: the Editor pane runs nvim from a shell (closing nvim leaves the shell); layout-coding.sh adds lazygit and a shell.
editor="$(win_id Editor)"
if [ -z "$editor" ]; then
  if [ "$fresh" = 1 ]; then # the new session's first window becomes the Editor
    editor="$(tuios list-windows -s "$session" --json | jq -r '.windows[0].window_id')"
    tuios set-window -s "$session" -w "$editor" --name Editor >/dev/null
  else
    editor="$(tuios new-window Editor -s "$session" --workspace 1 --cwd "$dir" --no-focus --print-id)"
  fi
  tuios send-text -s "$session" -w "$editor" "cd $(printf %q "$dir") && nvim
" >/dev/null
fi

# Workspace 2: the Jarvis pane (a shell, so it survives when claude exits).
jarvis="$(win_id Jarvis)"
[ -n "$jarvis" ] || jarvis="$(tuios new-window Jarvis -s "$session" --workspace 2 --cwd "$dir" --no-focus --print-id)"
tty="$(tuios list-windows -s "$session" --json | jq -r --arg id "$jarvis" '.windows[] | select(.window_id == $id) | .tty')"
procs="$(ps -t "${tty#/dev/}" -o command= 2>/dev/null || true)" # not piped into grep -q: pipefail + SIGPIPE
if [[ "$procs" == *"claude --agent jarvis"* ]]; then
  echo "crewx: Jarvis is already running in $session"
else
  tuios send-text -s "$session" -w "$jarvis" "cd $(printf %q "$dir") && claude --agent jarvis --settings $(printf %q "$SETTINGS")
" >/dev/null
fi

# Workspace 3: activity log (left) and .crewx/STATE.md (right); tiling places them side by side.
[ -n "$(win_id Activity)" ] || tuios new-window Activity -s "$session" --workspace 3 --cwd "$dir" --no-focus -- "$CREWX/logs-activity.sh" "$dir" >/dev/null
[ -n "$(win_id Plan)" ]     || tuios new-window Plan     -s "$session" --workspace 3 --cwd "$dir" --no-focus -- "$CREWX/logs-plan.sh" "$dir" >/dev/null

tuios select-workspace -s "$session" 2 >/dev/null
tuios focus-window -s "$session" "$jarvis" >/dev/null || true

# Splits need the client that attach / switch-session brings, so the Coding layout is shaped in the background.
nohup "$CREWX/layout-coding.sh" "$session" "$dir" "$jarvis" >/dev/null 2>&1 &

if [ -n "${TUIOS_SESSION:-}" ]; then
  exec tuios switch-session "$session"
else
  exec tuios attach "$session"
fi
