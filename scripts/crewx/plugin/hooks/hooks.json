{
  "description": "crewx: per-session state file, deterministic gate at the end of the lead's turn, subagent log",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"", "timeout": 20 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.sh\"", "timeout": 900 }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-event.sh\"", "timeout": 10 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-event.sh\"", "timeout": 10 }]
      }
    ]
  }
}
