{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(wt *)",
      "Bash(just *)",
      "Bash(mise *)",
      "Bash(podman *)",
      "Bash(podman-compose *)",
      "Bash(tofu *)",
      "Bash(ansible-lint *)",
      "Bash(ansible-inventory *)",
      "Bash(trivy *)",
      "Bash(gitleaks *)",
      "Bash(semgrep *)",
      "Bash(tuios *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(hadolint *)",
      "Bash(govulncheck *)",
      "Bash(tflint *)",
      "Bash(actionlint *)",
      "Bash(brew *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(realpath *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(pg_isready *)",
      "Bash(glow *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sed *)",
      "Bash(gsed *)",
      "Bash(awk *)",
      "Bash(grep *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpx *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(podman system prune *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/dev/repos/onexbash",
      "~/dev/repos/cratos",
      "~/dev/worktrees",
      "~/.local/share/dotfiles",
      "~/.config"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 310
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "tuios agent-statusline claude-code --integration 1"
  },
  "enabledPlugins": {
    "svelte@svelte": true,
    "ponytail@ponytail": true,
    "impeccable@impeccable": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "github.com"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git push *",
      "git pull *",
      "git fetch *",
      "git clone *",
      "gh *",
      "wt *",
      "tuios *",
      "podman *",
      "podman-compose *",
      "pnpm *",
      "pnpx *",
      "tofu *",
      "ansible *",
      "ansible-playbook *",
      "open *",
      "osascript *"
    ]
  },
  "spinnerTipsEnabled": false,
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": false
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "autoCompactThreshold": 80
}
