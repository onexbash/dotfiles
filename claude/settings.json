    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowUnixSockets": ["/tmp/tuios-501"]
    },
    "excludedCommands": ["podman"]
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": false
      }
    }
  },
  "theme": "custom:catppuccin-mocha",
  "editorMode": "vim"
}
