{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 310
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "tuios agent-statusline claude-code --integration 1"
  },
  "enabledPlugins": {
    "svelte@svelte": true,
    "ponytail@ponytail": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "git",
        "url": "https://github.com/sveltejs/ai-tools.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/dietrichgebert/ponytail.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    }
  },
  "theme": "dark-ansi"
}
