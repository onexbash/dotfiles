# Environment Variables needed by ALL Shells
export SHELL_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
export SHELL_SCRIPTS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/scripts"
export SHELL_UTILS="${SHELL_CONFIG_DIR}/util.sh"
